---
import Layout from '../../layouts/Layout.astro';

const links = [
  {
    num: '١',
    title: 'انضم لقائمة الانتظار',
    href: 'https://console.typesafe.ai',
    desc: 'سجّل دخول بـ Google أو إيميلك — تنحط على قائمة الانتظار تلقائي. Jev لسه بمرحلة Early Access، هذا لازم أول خطوة.',
    cta: 'console.typesafe.ai',
  },
  {
    num: '٢',
    title: 'الـ Skill الرسمي لـ Claude Code',
    href: 'https://github.com/typesafe-ai/skills',
    desc: 'من TypeSafe نفسها. يعلّم Claude Code يستخدم Jev صح.',
    cta: 'github.com/typesafe-ai/skills',
    code: ['claude plugin marketplace add typesafe-ai/skills', 'claude plugin install typesafe@typesafe-ai'],
  },
  {
    num: '٣',
    title: 'الـ Cookbooks الرسمية',
    href: 'https://docs.typesafe.ai/cookbooks',
    desc: 'أنماط جاهزة من TypeSafe — من كم سؤال بسيط إلى pipeline كامل، بالكود.',
    cta: 'docs.typesafe.ai/cookbooks',
  },
  {
    num: '٤',
    title: 'Community Jev radar',
    href: 'https://jevbest.com',
    desc: 'قائمة مجتمعية — مو من TypeSafe رسمياً — لـ٦٤٠+ مشروع مفتوح المصدر مبني بـ Jev، مقسّمة ١١ تصنيف، تتحدّث يومياً.',
    cta: 'jevbest.com',
    badge: 'مجتمعي، مو رسمي',
  },
];
---

<Layout
  title="Jev: AI ما يكتب… يقرر · من @eng_menawer"
  description="تعطيه الموقف والخيارات، يرجع لك قرار Typed بثقة محسوبة. روابط Jev — TypeSafe AI's System One model — قائمة الانتظار، الـ skill الرسمي، الـ cookbooks، وقائمة مجتمعية للمشاريع."
  ogPath="/jev"
  noindex
>
  <!-- ── Hero ── -->
  <section dir="rtl" class="mx-auto max-w-4xl px-5 sm:px-8 pt-8 sm:pt-16 pb-12 text-right font-cairo">
    <span class="inline-flex flex-row-reverse items-center gap-2 text-xs uppercase tracking-[0.18em] font-semibold text-claude-orange">
      <span class="w-1.5 h-1.5 rounded-full bg-claude-orange"></span>
      قرار · من @eng_menawer
    </span>

    <h1 class="mt-6 font-extrabold tracking-tight leading-[1.15] text-5xl sm:text-7xl">
      <span dir="ltr" class="inline-block text-claude-orange">Jev</span>: AI ما يكتب… يقرر
    </h1>

    <p class="mt-8 text-lg sm:text-xl text-ink/75 leading-relaxed max-w-2xl ml-auto">
      تعطيه الموقف والجوابات المحتملة، يرجع لك قرار من نوع محدد —
      <strong class="text-ink" dir="ltr">Score</strong>، أو
      <strong class="text-ink" dir="ltr">Noul</strong> (احتمالية نعم/لا)، أو
      <strong class="text-ink" dir="ltr">Choice</strong> —
      مع مقدار ثقته فيه.
    </p>
  </section>

  <!-- ── تنبيه: Early Access ── -->
  <section dir="rtl" class="mx-auto max-w-4xl px-5 sm:px-8 pb-12 font-cairo text-right">
    <div class="bg-claude-orange/8 border border-claude-orange/25 rounded-xl p-5 sm:p-6">
      <h2 class="font-bold text-lg text-ink mb-2">Jev لسه بمرحلة Early Access</h2>
      <p class="text-ink/75 text-sm leading-relaxed">
        ما تقدر تستخدمه مباشرة — لازم تنضم لقائمة الانتظار الأول (الرابط الأول تحت).
        باقي الروابط تفيدك أول ما توصلك الموافقة.
      </p>
    </div>
  </section>

  <!-- ── الروابط ── -->
  <section dir="rtl" class="mx-auto max-w-4xl px-5 sm:px-8 pb-16 font-cairo text-right">
    <h2 class="text-2xl font-bold text-ink mb-6">الروابط</h2>

    <div class="grid gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="group block bg-paper/40 border border-ink/5 rounded-xl p-5 sm:p-6 hover:border-claude-orange/40 hover:bg-paper/70 transition-colors"
        >
          <div class="flex flex-row-reverse items-baseline gap-3 mb-2 flex-wrap">
            <span class="font-extrabold text-claude-orange text-2xl">{l.num}</span>
            <h3 class="font-bold text-lg text-ink">{l.title}</h3>
            {l.badge && (
              <span class="text-[11px] font-semibold uppercase tracking-wide text-ink/50 bg-ink/5 rounded-full px-2.5 py-1">
                {l.badge}
              </span>
            )}
          </div>
          <p class="text-ink/75 text-sm leading-relaxed">{l.desc}</p>
          {l.code && (
            <pre dir="ltr" class="mt-3 text-left text-xs sm:text-sm bg-ink text-cream/90 rounded-lg p-4 overflow-x-auto font-mono leading-relaxed"><code>{l.code.join('\n')}</code></pre>
          )}
          <span dir="ltr" class="mt-3 inline-flex items-center gap-1.5 text-xs text-ink/45 group-hover:text-claude-orange transition-colors">
            {l.cta}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M7 7h10v10"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── تجربة منور ── -->
  <section dir="rtl" class="mx-auto max-w-4xl px-5 sm:px-8 pb-16 font-cairo text-right">
    <div class="border-t border-ink/10 pt-8 text-sm text-ink/60 leading-relaxed">
      <p>
        منور جرّبه يرتب مكالمات العملاء حسب أولوية المتابعة —
        <span dir="ltr">Score</span> + أعلام نعم/لا + <span dir="ltr">Choice</span>،
        وكانت كل مكالمة تاخذ حوالي ٠.٣–٠.٥ ثانية بتجربته الشخصية.
        بدون بيانات عملاء حقيقية، وبدون أي رقم دقة مضمون.
      </p>
    </div>
  </section>

  <!-- ── Bottom CTA ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-20">
    <div dir="rtl" class="bg-ink text-cream rounded-2xl p-8 sm:p-10 flex flex-col sm:flex-row-reverse sm:items-center sm:justify-between gap-6 font-cairo text-right">
      <div>
        <p class="text-cream/60 text-xs uppercase tracking-[0.18em] font-semibold">جاهز؟</p>
        <p class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight">
          انضم لقائمة الانتظار، وابدأ من هناك.
        </p>
      </div>
      <a
        href="https://console.typesafe.ai"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-3 bg-claude-orange text-cream px-7 py-4 rounded-full font-semibold text-base hover:bg-cream hover:text-ink transition-colors cursor-pointer whitespace-nowrap shrink-0"
      >
        console.typesafe.ai
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M7 7h10v10"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>
