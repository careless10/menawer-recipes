---
import Layout from '../../layouts/Layout.astro';
import recipeRaw from '../../content/connect-claude-and-codex.md?raw';

const recipeLength = recipeRaw.length;
---

<Layout
  title="Make Claude and ChatGPT talk to each other · by @eng_menawer"
  description="Copy the recipe, paste it into Claude Code, and get Claude and Codex sending each other messages on your own machine. Verified on macOS and Windows."
  ogPath="/bridge/en"
  noindex
>

  <!-- Language toggle -->
  <div class="mx-auto max-w-4xl px-5 sm:px-8 pt-5 flex justify-start">
    <a href="/bridge"
       class="inline-flex flex-row-reverse items-center gap-2 text-sm text-ink/60 hover:text-claude-orange transition-colors font-semibold font-cairo">
      العربية
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
    </a>
  </div>

  <!-- ── Hero ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pt-8 sm:pt-16 pb-12">
    <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-semibold text-claude-orange">
      <span class="w-1.5 h-1.5 rounded-full bg-claude-orange"></span>
      Recipe · by @eng_menawer
    </span>

    <h1 class="mt-6 font-extrabold tracking-tight leading-[1.05] text-5xl sm:text-7xl">
      Make <span class="text-claude-orange">Claude</span> and <span class="text-claude-orange">ChatGPT</span> talk to each other
    </h1>

    <p class="mt-8 text-lg sm:text-xl text-ink/75 leading-relaxed max-w-2xl">
      Two AI agents on the same machine, sending each other messages in both directions — instead of you copy-pasting between two terminals.
      <strong class="text-ink">Claude Code ↔ Codex, landing in seconds.</strong>
    </p>

    <div class="mt-10 flex flex-wrap gap-3 items-center">
      <button
        id="copy-btn"
        class="group inline-flex items-center justify-center gap-3 bg-claude-orange text-cream px-7 py-4 rounded-full font-semibold text-base hover:bg-ink transition-colors cursor-pointer"
        aria-label="Copy the recipe"
      >
        <svg class="copy-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="check-icon hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        <span class="copy-label">Copy the recipe</span>
      </button>
    </div>

    <p class="mt-5 text-xs text-ink/40 uppercase tracking-wider">
      {recipeLength.toLocaleString()} characters · paste into <strong class="text-ink/55">Claude Code</strong> (terminal), not claude.ai
    </p>
  </section>

  <!-- ── Important ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-12">
    <div class="bg-claude-orange/8 border border-claude-orange/25 rounded-xl p-5 sm:p-6">
      <h2 class="font-bold text-lg text-ink mb-2">This needs Claude Code — not claude.ai</h2>
      <p class="text-ink/75 text-sm leading-relaxed">
        The recipe works against sockets and files on your own machine, which a browser tab can't reach.
        You need <a href="https://www.anthropic.com/claude-code" target="_blank" rel="noopener" class="text-ink/85 underline underline-offset-2 decoration-claude-orange/40 hover:text-claude-orange">Claude Code</a> in your terminal.
        Paste it into the web chat and Claude will tell you so and stop.
      </p>
    </div>
  </section>

  <!-- ── How it works ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-16">
    <h2 class="text-2xl font-bold text-ink mb-6">How it works</h2>

    <ol class="grid sm:grid-cols-2 gap-4">
      <li class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <div class="flex items-baseline gap-3 mb-2">
          <span class="font-extrabold text-claude-orange text-2xl">1</span>
          <h3 class="font-bold text-lg">Open Claude Code</h3>
        </div>
        <p class="text-ink/75 text-sm leading-relaxed">
          Run <code class="text-ink/85">claude</code> in your terminal. You'll also need Codex installed and logged in.
        </p>
      </li>
      <li class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <div class="flex items-baseline gap-3 mb-2">
          <span class="font-extrabold text-claude-orange text-2xl">2</span>
          <h3 class="font-bold text-lg">Paste the recipe</h3>
        </div>
        <p class="text-ink/75 text-sm leading-relaxed">
          Hit the orange button and paste the whole thing. Claude asks whether you want English or Arabic.
        </p>
      </li>
      <li class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <div class="flex items-baseline gap-3 mb-2">
          <span class="font-extrabold text-claude-orange text-2xl">3</span>
          <h3 class="font-bold text-lg">Preflight</h3>
        </div>
        <p class="text-ink/75 text-sm leading-relaxed">
          Claude checks your machine first — and tells you honestly if it can't do this, instead of wasting your time.
        </p>
      </li>
      <li class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <div class="flex items-baseline gap-3 mb-2">
          <span class="font-extrabold text-claude-orange text-2xl">4</span>
          <h3 class="font-bold text-lg">Test both directions</h3>
        </div>
        <p class="text-ink/75 text-sm leading-relaxed">
          Claude wires up both channels, sends Codex a test message, and teaches Codex how to reply.
        </p>
      </li>
    </ol>
  </section>

  <!-- ── What you end up with ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-16">
    <h2 class="text-2xl font-bold text-ink mb-6">What you end up with</h2>

    <div class="grid sm:grid-cols-3 gap-4">
      <div class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <h3 class="font-semibold text-lg text-claude-orange">Claude → Codex</h3>
        <p class="mt-2 text-ink/75 text-sm leading-relaxed">
          Claude drops a message into a live Codex session — you watch it arrive on screen.
        </p>
      </div>
      <div class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <h3 class="font-semibold text-lg text-claude-orange">Codex → Claude</h3>
        <p class="mt-2 text-ink/75 text-sm leading-relaxed">
          And Codex answers back — landing in your Claude session exactly as if you'd typed it.
        </p>
      </div>
      <div class="bg-paper/40 border border-ink/5 rounded-xl p-5">
        <h3 class="font-semibold text-lg text-claude-orange">macOS + Windows</h3>
        <p class="mt-2 text-ink/75 text-sm leading-relaxed">
          Both directions tested on both. Windows uses a named pipe instead of a socket — the recipe handles it.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Straight talk ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-16">
    <div class="border-t border-ink/10 pt-8 text-sm text-ink/60 leading-relaxed space-y-3">
      <p>
        <strong class="text-ink/80 font-semibold">This is not an official feature.</strong>
        It uses internal, undocumented plumbing inside Claude Code and Codex. It works today and any update to either tool can break it.
      </p>
      <p>
        <strong class="text-ink/80 font-semibold">Bidirectional, but not a live conversation.</strong>
        Each direction is a separate one-shot send. Think texting, not a phone call.
      </p>
      <p>
        <strong class="text-ink/80 font-semibold">Anyone who can read the token file can impersonate you</strong>
        to that session, so both agents must run as the same OS user. On Windows the key files don't get Unix permissions at all — the recipe spells this out rather than glossing it.
      </p>
    </div>
  </section>

  <!-- ── Bottom CTA ── -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-20">
    <div class="bg-ink text-cream rounded-2xl p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <p class="text-cream/60 text-xs uppercase tracking-[0.18em] font-semibold">Ready?</p>
        <p class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight">
          Copy the recipe, paste it into Claude Code.
        </p>
      </div>
      <button
        id="copy-btn-bottom"
        class="inline-flex items-center justify-center gap-3 bg-claude-orange text-cream px-7 py-4 rounded-full font-semibold text-base hover:bg-cream hover:text-ink transition-colors cursor-pointer whitespace-nowrap shrink-0"
        aria-label="Copy the recipe"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        Copy the recipe
      </button>
    </div>
  </section>

  <!-- payload + copy script -->
  <script id="recipe-payload" type="text/plain" set:html={recipeRaw}></script>
  <script is:inline data-toast-copied="Copied — paste into Claude Code" data-toast-original="Copy the recipe">
    (function () {
      const payload = document.getElementById('recipe-payload')?.textContent ?? '';
      const root = document.currentScript;
      const COPIED = root?.dataset?.toastCopied ?? 'Copied — paste into Claude Code';
      const ORIGINAL = root?.dataset?.toastOriginal ?? 'Copy the recipe';

      async function copyRecipe(btn) {
        try {
          await navigator.clipboard.writeText(payload);
          flashSuccess(btn);
        } catch (err) {
          const ta = document.createElement('textarea');
          ta.value = payload;
          ta.style.position = 'fixed';
          ta.style.left = '-1000px';
          document.body.appendChild(ta);
          ta.focus(); ta.select();
          try { document.execCommand('copy'); flashSuccess(btn); }
          catch { alert("Couldn't copy automatically — please select the recipe text manually."); }
          finally { document.body.removeChild(ta); }
        }
      }

      function flashSuccess(btn) {
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label') ?? btn.querySelector('span');
        if (copyIcon && checkIcon) { copyIcon.classList.add('hidden'); checkIcon.classList.remove('hidden'); }
        if (label) label.textContent = COPIED;
        setTimeout(() => {
          if (copyIcon && checkIcon) { copyIcon.classList.remove('hidden'); checkIcon.classList.add('hidden'); }
          if (label) label.textContent = ORIGINAL;
        }, 2400);
      }

      document.getElementById('copy-btn')?.addEventListener('click', (e) => copyRecipe(e.currentTarget));
      document.getElementById('copy-btn-bottom')?.addEventListener('click', (e) => copyRecipe(e.currentTarget));
    })();
  </script>
</Layout>
